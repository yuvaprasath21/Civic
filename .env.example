APP_ENV=development
DEBUG=true
DATABASE_URL=mysql+pymysql://civic_user:civic_pass@localhost:3306/civic_issues_db
JWT_SECRET=replace_with_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080
UPLOAD_DIRECTORY=../uploads
MAX_UPLOAD_SIZE=10485760
AI_MODEL_PATH=./ai/models/yolo_civic.pt
AI_PROVIDER=mock
AI_MIN_CONFIDENCE=0.35
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DUPLICATE_RADIUS_METERS=75
DUPLICATE_TIME_WINDOW_HOURS=168
RATE_LIMIT_PER_MINUTE=60
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=civic_issues_db
MYSQL_USER=civic_user
MYSQL_PASSWORD=civic_pass

# --- OTP verification (email + mobile) ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# "console" prints OTPs to the backend terminal (development only; no accounts needed).
# Switch to "smtp" / "twilio" for real delivery.
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords). Use the 16-char password with NO spaces.
# Never use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Twilio: values from console.twilio.com. Mobile numbers must be E.164 (+919876543210).
# Trial accounts can only text numbers you've verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
